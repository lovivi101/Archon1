# Copy this file to .env and set a unique strong password before deployment.
POSTGRES_DB=avalon
POSTGRES_USER=avalon
POSTGRES_PASSWORD=
HOST_PORT=8888
AVALON_NIGHT_SECONDS=2
AVALON_AI_TICK_MS=250
AVALON_PROPOSE_SECONDS=60
AVALON_VOTE_SECONDS=30
AVALON_MISSION_SECONDS=30
AVALON_ASSASSIN_SECONDS=60
AVALON_MAX_ROOMS=1000
AVALON_ABANDON_SECONDS=60
# Signs login tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AVALON_TOKEN_SECRET=
AVALON_TOKEN_TTL_DAYS=30
# 1 lets clients log in with a self-declared userId (current Cocos/Godot demos). Keep 0 for public servers.
AVALON_ALLOW_LEGACY_LOGIN=0
# WeChat mini-game credentials for wx.login() code exchange. Leave empty to disable WeChat login.
WECHAT_APPID=
WECHAT_SECRET=
