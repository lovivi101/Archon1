{
    "name": "avalon-ts-server",
    "version": "0.1.0",
    "private": true,
    "description": "Avalon local development server compatible with the Cocos client protocol",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "db:migrate": "node scripts/migrate.js",
        "test:smoke": "npm run build && node scripts/rules-test.js && node scripts/smoke-test.js"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/platform-ws": "^11.0.0",
        "@nestjs/websockets": "^11.0.0",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^22.15.0",
        "@types/pg": "^8.23.1",
        "@types/ws": "^8.18.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    }
}
